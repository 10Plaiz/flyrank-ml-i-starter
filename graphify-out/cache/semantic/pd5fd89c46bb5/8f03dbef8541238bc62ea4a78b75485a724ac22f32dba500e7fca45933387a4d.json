{"nodes": [{"id": "docs_flyrank_seo_research_march_2026", "label": "The State of AI-Driven SEO (March 2026)", "file_type": "paper", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "36-page public-safe portfolio study (341,701 content pieces, 57 brands) with direct aggregate comparisons as primary evidence and an exploratory ML appendix on 61,790 active records."}, {"id": "docs_flyrank_seo_research_march_2026_thesis", "label": "Refresh-Before-Decay Thesis", "file_type": "rationale", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most useful SEO decisions come from simple validated comparisons: refresh strong content before it decays, protect page-one assets, read composite scores through raw search performance."}, {"id": "docs_flyrank_seo_research_march_2026_evidence_standard", "label": "Evidence Standard (Direct Comparisons Over ML)", "file_type": "rationale", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Headline findings use direct aggregate comparisons; ML is exploratory appendix and never overrides portfolio evidence; external SEO beliefs are hypotheses."}, {"id": "docs_flyrank_seo_research_march_2026_active_content_subset", "label": "Active-Content Feature-Vector Subset", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Local subset with impressions_90d > 0 and sessions_90d > 0 used for extended cuts and the ML appendix; introduces survivor bias in some cells."}, {"id": "docs_flyrank_seo_research_march_2026_health_score", "label": "Health Score Composite (0-100)", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Impressions 30 + position 30 + CTR 20 + scroll depth 20 points; internal summary metric, paired with raw search performance."}, {"id": "docs_flyrank_seo_research_march_2026_position_tiers", "label": "Position Tiers", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Top 3, Page 1 (4-10), Striking Distance (11-20), Page 3-5 (21-50), Deep (50+)."}, {"id": "docs_flyrank_seo_research_march_2026_trend_direction_definition", "label": "Trend Direction Definition", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "30d vs previous 30d impression change: up >10%, down >10% decline, stable within +/-10%, flat insufficient data, new created within 30 days."}, {"id": "docs_flyrank_seo_research_march_2026_anatomy_of_growing_content", "label": "Finding 1: Anatomy of Growing Content", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Growing pages are ~37.6% longer and ~20% younger than declining pages; observational."}, {"id": "docs_flyrank_seo_research_march_2026_content_performance_curve", "label": "Finding 2: Content Performance Curve", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Health peaks at 61-90 days, decay cliff at 271-365 days, 365+ rebound concentrated in refreshed pages."}, {"id": "docs_flyrank_seo_research_march_2026_click_capture_by_position", "label": "Finding 3: Click Capture by Position Tier", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Weighted CTR falls from 0.423% in top 3 to 0.050% deep (~88% drop)."}, {"id": "docs_flyrank_seo_research_march_2026_freshness_multiplier", "label": "Finding 4: Freshness Multiplier", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "31-90 day freshness window strongest stable growth ratio (7.88:1); refreshed 365+ pages show 3.2x health and 57x impressions; 361+ bucket unstable."}, {"id": "docs_flyrank_seo_research_march_2026_engagement_visibility", "label": "Finding 5: Engagement and Visibility Consistency", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "High scroll + high engagement +11.2 health; pages visible 80+ of 90 days score 46.8 vs 28.4 for sporadic."}, {"id": "docs_flyrank_seo_research_march_2026_ai_traffic_signal", "label": "Finding 6: AI Referral Traffic Signal", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "AI referrals ~1.06% of sessions; high-AI pages have more impressions but weaker average position than no-AI pages."}, {"id": "docs_flyrank_seo_research_march_2026_winning_combinations", "label": "Finding 7: Intent x Competition x Depth", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Transactional low-competition topics lead health and impressions; depth matters most where demand exists."}, {"id": "docs_flyrank_seo_research_march_2026_age_freshness_matrix", "label": "Finding 8: Age-Freshness Matrix", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Old-but-refreshed content (44.62) performs nearly as well as young-fresh content (44.12); mid-age stale is the main decay zone."}, {"id": "docs_flyrank_seo_research_march_2026_captured_traffic_value", "label": "Finding 9: Captured Click-Equivalent Value", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use clicks x CPC rather than impressions x CPC, since impressions are not billable clicks and inflate value."}, {"id": "docs_flyrank_seo_research_march_2026_ai_model_cohorts", "label": "Finding 10: Age-Controlled AI Model Cohorts", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Provider families each lead in some age cohorts; no blanket winner and no blanket AI penalty."}, {"id": "docs_flyrank_seo_research_march_2026_portfolio_trends", "label": "Finding 11: Portfolio-Level Monthly Trends", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_flyrank_seo_research_march_2026_myth_review", "label": "Reversed and Nuanced SEO Myths", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "pages 18-24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Search volume is a weak forecast; optimization flags mark leverage; word count is a threshold; AI content not penalized by default; freshness amplifies quality rather than replacing it."}, {"id": "docs_flyrank_seo_research_march_2026_ml_appendix", "label": "Exploratory ML Appendix", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "pages 25-30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Pearson correlations, k-means (k=5) archetypes, PCA, random forest on health score, logistic regression on growth (71% holdout accuracy), shallow decision tree, percentile distributions."}, {"id": "docs_flyrank_seo_research_march_2026_rf_health_importance", "label": "Random Forest Health-Score Feature Importance", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Average position and impressions dominate, but health score is constructed from those inputs, so importance is descriptive not causal."}, {"id": "docs_flyrank_seo_research_march_2026_growth_logistic_regression", "label": "Growth vs Decline Logistic Regression", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Separates growing from declining pages; content age strongest negative signal, days visible and recent impressions positive."}, {"id": "docs_flyrank_seo_research_march_2026_content_refresh_playbook", "label": "Content Refresh Playbook", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Identify candidates, expand thin sections, update facts, improve engagement, resubmit and monitor at 30/60/90 days."}, {"id": "docs_flyrank_seo_research_march_2026_priority_actions", "label": "Priority Actions Playbook", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_flyrank_seo_research_march_2026_structural_risks", "label": "Structural Portfolio Risks", "file_type": "concept", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Cannibalization of overlapping demand and incomplete indexing coverage."}, {"id": "docs_flyrank_seo_research_march_2026_observational_limitations", "label": "Observational Limitations", "file_type": "rationale", "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": "page 36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Correlations do not prove causation; health score is internal; age confounds model comparisons; no p-values or CIs reported."}], "edges": [{"source": "docs_flyrank_seo_research_march_2026", "target": "docs_flyrank_seo_research_march_2026_thesis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": null, "weight": 1.0}, {"source": "docs_flyrank_seo_research_march_2026", "target": "docs_flyrank_seo_research_march_2026_evidence_standard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/flyrank-seo-research-march-2026.pdf", "source_location": null, "weight": 1.0}, {"source": "docs_flyrank